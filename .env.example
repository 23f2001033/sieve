# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM for the buyer and red-team agents (sieve/agents/, NOT the money path) ---
# xAI Grok. The API is OpenAI-compatible; SIEVE calls it over plain httpx.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# --- Razorpay test mode (OPTIONAL) ---
# Test-mode keys are FREE (test mode moves no real money) — sign up at
# https://dashboard.razorpay.com and read them from Settings > API Keys in test
# mode. If unset, the Razorpay leg degrades to a documented in-process stub and
# this is disclosed in the README rather than hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
